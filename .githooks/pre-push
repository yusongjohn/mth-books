#!/bin/sh
# Export local SQLite favorites to data/favorites.json before push.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/viewer"
if [ ! -f package.json ]; then
  echo "viewer/ missing; skip favorites export"
  exit 0
fi
npm run export-favorites
cd "$ROOT"
git add data/favorites.json
if ! git diff --cached --quiet -- data/favorites.json; then
  echo ""
  echo "data/favorites.json was updated from SQLite and staged."
  echo "Commit it before pushing, e.g.:"
  echo "  git commit -m \"chore: sync favorites from sqlite\""
  echo ""
  exit 1
fi
